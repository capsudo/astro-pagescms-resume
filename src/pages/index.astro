---
import {
  Boxes,
  CalendarRange,
  ChevronDown,
  Ellipsis,
  ExternalLink,
  Sparkles,
  Languages,
  Mail,
  MapPin,
  Menu,
  IdCard,
  Phone,
  Search,
  Share,
  Wrench,
  Layers,
  BriefcaseBusiness,
} from "@lucide/astro";
import Avatar from "../components/ui/Avatar.astro";
import Badge from "../components/ui/Badge.astro";
import Card from "../components/ui/Card.astro";
import Separator from "../components/ui/Separator.astro";
import {
  createSocialProfileUrl,
  createReadablePeriodLabel,
  bio,
  jobs,
  findTechnologyBySlug,
  identity,
  projects,
  socials,
  technologyGroups,
  type Project,
} from "../lib/data";
import "../styles/global.css";

const coverImageUrl = "/media/layered_mountains.svg";
const avatarImageUrl = identity.photoUrl || bio.avatarUrl;
// User photo filter
const avatarImageFilterCss = "grayscale(100%) brightness(1.12) contrast(1.04)";
const initials = identity.name
  .split(" ")
  .map((namePart) => namePart[0])
  .join("")
  .slice(0, 2)
  .toUpperCase();

const featuredSocials = socials.filter((social) => social.featured);
const githubSocial = socials.find((social) => social.slug === "github");

const projectGroups = Object.entries(
  projects.reduce<Record<string, Project[]>>((projectsByYear, project) => {
    const projectYear = project.periodStartDate.slice(0, 4);
    const existingProjectsForYear = projectsByYear[projectYear] ?? [];

    return {
      ...projectsByYear,
      [projectYear]: [...existingProjectsForYear, project],
    };
  }, {}),
).sort(([leftYear], [rightYear]) => Number(rightYear) - Number(leftYear));

function collectProjectTechnologies(project: Project) {
  const allTechnologySlugs = [...project.languageSlugs, ...project.frameworkSlugs, ...project.toolSlugs];

  return allTechnologySlugs
    .map((technologySlug) => findTechnologyBySlug(technologySlug))
    .filter((technology) => Boolean(technology));
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={bio.shortDescription} />
    <title>{identity.name} - Resume</title>
  </head>
  <body>
    <main class="page-shell">
      <nav class="flex h-11 items-center justify-between px-4 text-sm text-foreground" aria-label="Page toolbar">
        <div class="flex items-center gap-2">
          <Avatar class="h-5 w-5 border-0 text-[0.6rem]" imageFilterCss={avatarImageFilterCss} imageUrl={avatarImageUrl} initials={initials} name={identity.name} />
          <span>{identity.name}</span>
        </div>
        <div class="flex items-center gap-4 text-muted-foreground">
          <Search class="h-5 w-5" aria-hidden="true" />
          <Share class="h-5 w-5" aria-hidden="true" />
          <Ellipsis class="h-5 w-5" aria-hidden="true" />
        </div>
      </nav>

      <img class="cover-image" src={coverImageUrl} alt="" />

      <section class="notion-content">
        <header class="relative pt-0">
          <Avatar
            class="-mt-[72px] h-28 w-28 shadow-sm sm:-mt-[76px] sm:h-32 sm:w-32"
            imageFilterCss={avatarImageFilterCss}
            imageUrl={avatarImageUrl}
            initials={initials}
            name={identity.name}
          />

          <div class="mt-8 flex items-start justify-between gap-6">
            <div class="min-w-0">
              <h1 class="text-4xl font-bold tracking-normal text-foreground sm:text-5xl">{identity.name}</h1>
              <div class="mt-6 grid gap-3 text-base sm:grid-cols-[180px_1fr]">
                <p class="italic text-foreground">{bio.headline}</p>
                {
                  githubSocial && (
                    <a class="text-foreground no-underline hover:underline" href={createSocialProfileUrl(githubSocial)}>
                      @{githubSocial.username}
                    </a>
                  )
                }
              </div>
            </div>
            <Menu class="mt-2 h-7 w-7 shrink-0 text-muted-foreground" aria-hidden="true" />
          </div>

          <div class="mt-10 max-w-2xl space-y-3 text-base leading-7 text-foreground">
            <p>{bio.shortDescription}</p>
            <p>{bio.longDescription}</p>
          </div>
        </header>

        <div class="mt-12 grid items-start gap-12 lg:grid-cols-[240px_minmax(0,1fr)]">
          <aside class="min-w-0 space-y-10">
            <section aria-labelledby="contact-title">
              <h2 id="contact-title" class="title">
                Contact
                <IdCard class="title-icon title-icon-bigger" aria-hidden="true" />
              </h2>

              <address class="mt-4 space-y-3 text-sm not-italic text-muted-foreground">
                <a class="flex items-center gap-3 text-foreground underline decoration-border underline-offset-4" href={`tel:${identity.phone}`}>
                  <Phone class="h-4 w-4 text-rose-600" aria-hidden="true" />
                  <span>{identity.phone}</span>
                </a>
                <p class="flex items-center gap-3">
                  <MapPin class="h-4 w-4 text-red-500" aria-hidden="true" />
                  <span>{identity.location}</span>
                </p>
                <a class="flex items-center gap-3 text-muted-foreground underline decoration-border underline-offset-4" href={`mailto:${identity.email}`}>
                  <Mail class="h-4 w-4 text-slate-500" aria-hidden="true" />
                  <span>{identity.email}</span>
                </a>
              </address>

              <div class="mt-5 flex flex-wrap items-center gap-3">
                {featuredSocials.map((social) => (
                  <a
                    class="inline-flex h-6 w-6 items-center justify-center no-underline opacity-95 transition-opacity hover:opacity-65 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ring"
                    href={createSocialProfileUrl(social)}
                    aria-label={social.name}
                    title={social.name}
                    target="_blank"
                    rel="noreferrer"
                  >
                    <img class="h-5 w-5" src={social.iconUrl} alt="" loading="lazy" />
                  </a>
                ))}
              </div>
            </section>

            <section aria-labelledby="stack-title">
              <h2 id="stack-title" class="title">
                Stack
                <Layers class="title-icon" aria-hidden="true" />
              </h2>
              <div class="mt-5 space-y-7">
                {technologyGroups.map((technologyGroup) => (
                  <section aria-labelledby={`${technologyGroup.categoryName}-title`}>
                    <Badge class="gap-1.5 rounded-full px-3 py-1 text-sm" variant="secondary">
                      {technologyGroup.categoryName === "frameworks" && <Boxes class="h-4 w-4" aria-hidden="true" />}
                      {technologyGroup.categoryName === "languages" && <Languages class="h-4 w-4" aria-hidden="true" />}
                      {technologyGroup.categoryName === "tools" && <Wrench class="h-4 w-4" aria-hidden="true" />}
                      <span id={`${technologyGroup.categoryName}-title`}>{technologyGroup.categoryLabel}</span>
                    </Badge>
                    <ul class="mt-4 space-y-3">
                      {technologyGroup.items.map((technology) => (
                        <li>
                          <a class="flex items-center gap-3 text-sm text-foreground no-underline hover:underline" href={technology.githubProjectUrl}>
                            <img class="stack-icon" src={technology.localIconUrl} alt="" loading="lazy" />
                            <span>{technology.name}</span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  </section>
                ))}
              </div>
            </section>
          </aside>

          <section class="min-w-0" aria-labelledby="showcase-title">
            <div class="flex items-center justify-between gap-4">
              <h2 id="showcase-title" class="title">
                Showcase
                <Sparkles class="title-icon" aria-hidden="true" />
              </h2>
            </div>

            <Badge class="mt-4 rounded-full px-3 py-1 text-sm" variant="secondary">
              Showcase
            </Badge>

            <div class="mt-6 space-y-8">
              {projectGroups.map(([projectYear, projectsForYear]) => (
                <section aria-labelledby={`year-${projectYear}`}>
                  <h3 id={`year-${projectYear}`} class="mb-4 flex items-center gap-2 text-sm font-medium text-foreground">
                    <ChevronDown class="h-4 w-4" aria-hidden="true" />
                    <span>{projectYear}</span>
                    <span class="text-muted-foreground">{projectsForYear.length}</span>
                  </h3>

                  <div class="space-y-4">
                    {projectsForYear.map((project) => (
                      <Card class="overflow-hidden p-4 transition-colors hover:bg-accent/25">
                        <div class="flex items-start justify-between gap-4">
                          <div class="min-w-0">
                            <h4 class="text-base font-medium leading-6">
                              {project.projectUrl ? (
                                <a class="inline-flex items-center gap-1 hover:underline" href={project.projectUrl}>
                                  {project.name}
                                  <ExternalLink class="h-3.5 w-3.5 text-muted-foreground" aria-hidden="true" />
                                </a>
                              ) : (
                                project.name
                              )}
                            </h4>
                            <div class="mt-2 flex flex-wrap items-center gap-2">
                              <Badge variant={project.featured ? "pink" : "gold"}>{project.company}</Badge>
                              <span class="inline-flex items-center gap-1 text-xs text-muted-foreground">
                                <CalendarRange class="h-3.5 w-3.5" aria-hidden="true" />
                                {createReadablePeriodLabel(project.periodStartDate, project.periodEndDate)}
                              </span>
                            </div>
                          </div>
                        </div>

                        <div class="technology-strip -mx-1 mt-4 flex gap-3 overflow-x-auto px-1 pb-1 text-xs text-foreground">
                          {collectProjectTechnologies(project).map((technology) => (
                            <a class="inline-flex shrink-0 items-center gap-1.5 underline decoration-border underline-offset-4" href={technology?.githubProjectUrl}>
                              <img class="h-3.5 w-3.5 rounded-[2px]" src={technology?.localIconUrl} alt="" loading="lazy" />
                              <span>{technology?.name}</span>
                            </a>
                          ))}
                        </div>

                        <p class="mt-4 text-sm leading-6 text-foreground">{project.description}</p>
                      </Card>
                    ))}
                  </div>
                </section>
              ))}
            </div>

            <Separator class="my-10" />

            <section aria-labelledby="career-title">
              <h2 id="career-title" class="title">
                Career
                <BriefcaseBusiness class="title-icon" aria-hidden="true" />
              </h2>
              <div class="mt-6 space-y-4">
                {jobs.map((job) => (
                  <Card class="p-4">
                    <div class="flex flex-wrap items-center justify-between gap-2">
                      <h3 class="text-base font-medium">{job.name}</h3>
                      <span class="text-xs font-medium text-muted-foreground">
                        {createReadablePeriodLabel(job.periodStartDate, job.periodEndDate)}
                      </span>
                    </div>
                    <p class="mt-1 text-sm text-muted-foreground">{job.company} · {job.location}</p>
                    <p class="mt-3 text-sm leading-6 text-foreground">{job.description}</p>
                  </Card>
                ))}
              </div>
            </section>
          </section>
        </div>
      </section>
    </main>
  </body>
</html>
